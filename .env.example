# ---------------------------------------------------------------------------
# Credentials (REQUIRED -- the run aborts at startup if any are missing)
# ---------------------------------------------------------------------------

# "aurora" for aurora.bamboohr.com
BAMBOO_SUBDOMAIN=
# BambooHR API key. Used as the Basic Auth *username* (password is literally "x").
BAMBOO_API_KEY=
# Harvest account ID (Settings -> Developers)
HARVEST_ACCOUNT_ID=
# Harvest personal access token
HARVEST_TOKEN=


# ---------------------------------------------------------------------------
# What to reconcile
# ---------------------------------------------------------------------------

# Comma-separated BambooHR time-off type names. Anything not listed here is
# left completely untouched -- no reads, no writes, no reports.
# Match the names exactly as they appear in BambooHR (case-insensitive).
TIMEOFF_TYPES=PTO,Vacation

# Comma-separated Harvest task names that represent time off.
HARVEST_TASK_NAMES=PTO,Vacation

# OPTIONAL. If your firm keeps time off under dedicated project(s), list them
# here and only entries on those projects count. Leave blank to match the
# tasks above across every project.
HARVEST_PROJECT_NAMES=

# Maps a Harvest task name -> a BambooHR time-off type name, comma-separated
# "harvest=bamboo" pairs. Required when the names differ on the two sides, or
# when more than one type is reconciled -- without it the tool cannot tell
# which balance a given Harvest entry should count against.
# Example: HARVEST_TASK_NAMES=PTO,Vacation Day
#          TASK_TYPE_MAP=PTO=PTO,Vacation Day=Vacation
TASK_TYPE_MAP=PTO=PTO,Vacation=Vacation


# ---------------------------------------------------------------------------
# Thresholds -- the safety rails on automatic writes
# ---------------------------------------------------------------------------

# Deltas at or below this are float/rounding noise. Ignored, not adjusted.
TOLERANCE_HOURS=0.01

# CREDIT = hours returned TO the employee (requested more than they logged).
# A credit larger than this is flagged for review instead of auto-applied.
MAX_AUTO_CREDIT_HOURS=4.0

# DEBIT = hours taken FROM the employee (they logged more than they requested).
# Deliberately lower than the credit threshold: an automated job reducing
# someone's balance is the case that gets disputed.
# Set to 0 to require human review for EVERY debit, of any size.
MAX_AUTO_DEBIT_HOURS=2.0


# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# SQLite idempotency ledger + audit trail. On Azure Functions point this at
# the mounted share (e.g. /mounted/pto/ledger.db), NOT at local temp storage,
# which does not survive a restart. See the README's deployment section.
LEDGER_PATH=./data/ledger.db
LOG_DIR=./data/logs
REPORT_DIR=./data/reports


# ---------------------------------------------------------------------------
# HTTP behaviour
# ---------------------------------------------------------------------------
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=5
HTTP_BACKOFF_SECONDS=1.0
HTTP_USER_AGENT=PTO Reconciliation (contact: it@example.com)
